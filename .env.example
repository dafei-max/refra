OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5
OPENAI_TEXT_MAX_OUTPUT_TOKENS=2400
# Optional. Use a lower effort for faster reasoning models when supported by your selected model.
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional independent image gateway. Keep OPENAI_API_KEY for text/Responses;
# do not replace it with an image-only gateway AK.
# OPENAI_IMAGE_API_KEY=your-image-gateway-ak
# OPENAI_IMAGE_BASE_URL=https://aidp.bytedance.net/api/modelhub/online/v2/crawl/openai
# OPENAI_IMAGE_EDIT_BASE_URL=https://aidp.bytedance.net/gpt/openapi/online/v2/crawl/openai
PORT=5173

# --- Aliyun OSS (required on Vercel; local dev uses filesystem by default) ---
# ALIYUN_OSS_REGION=oss-cn-shanghai
# ALIYUN_OSS_BUCKET=refra-assets
# ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
# ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
# OSS_SIGNED_URL_TTL=3600
# STORAGE_BACKEND=fs

# --- Admin token protecting generation and write APIs (required on Vercel) ---
# ADMIN_TOKEN=your-admin-token

# --- Optional rate limits (requests per minute per IP) ---
# RATE_LIMIT_RUN_PER_MIN=3
# RATE_LIMIT_EXPAND_PER_MIN=10
# RATE_LIMIT_SEARCH_PER_MIN=10
# RATE_LIMIT_WRITE_PER_MIN=20
# MAX_UPLOAD_BYTES=26214400
# MAX_JSON_BYTES=2097152

# --- Image recognition via vision.cjs (百炼 / DashScope) ---
# Get a DashScope key at https://bailian.console.aliyun.com/ (new users get free tokens)
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# VISION_MODEL=qwen3.7-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
