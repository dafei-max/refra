{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "entrypoint": "server.mjs",
      "functions": {
        "server.mjs": {
          "regions": ["hnd1"],
          "maxDuration": 300,
          "includeFiles": "{Brief理解.md,设计判断.md,检索匹配.md,prompt生成.md,font/**,image/**,style/**,兜兜/**,uploads/**,data/**,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
